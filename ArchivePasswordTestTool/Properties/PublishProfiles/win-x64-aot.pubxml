<Project>

  <!--
    Native AOT 发布配置。

    用法（可用 UpxPath 追加 UPX 压缩）：
      dotnet publish ArchivePasswordTestTool\ArchivePasswordTestTool.csproj -c Release `
        -p:PublishProfile=Properties\PublishProfiles\win-x64-aot.pubxml `
        -p:UpxPath="C:\tools\upx\upx.exe"

    与 win-x64.pubxml（单文件 + 裁剪 + bundle）的关系：
    两者都能产出**单个 exe**，因为各语言资源已内嵌进主程序集（见 csproj 的
    EmbeddedResource LogicalName）——AOT 无法打包卫星程序集，资源内嵌是前提。

    取舍（实测）：
                    体积        启动
      单文件      11.90 MB     335 ms
      AOT          9.04 MB     130 ms
      AOT + UPX    3.45 MB     121 ms
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishAot>true</PublishAot>

    <!--
      AOT 产物是纯原生代码，没有 apphost / bundle 概念：
      CetCompat 只管 SDK 生成的宿主，这里用不上。
      单文件与 bundle 压缩也不适用（AOT 输出本身就是单个原生 PE）。
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!--
      不设 InvariantGlobalization：AOT 下 globalization 走 ICU，
      而本程序需要按系统 UI 语言选择界面语言（多语言是核心功能）。
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      DebugType/DebugSymbols 管不到 ILCompiler 的原生符号：
      Microsoft.NETCore.Native.Publish.targets 里的 _CopyAotSymbols target
      由 CopyOutputSymbolsToPublishDirectory 控制，默认 true —— 于是发布目录
      会多一个 35 MB 的 .pdb，破坏「单文件下载」形态。显式关掉。
    -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!--
      AOT 的最小化开关：去掉反射式框架特性（与单文件发布时同理）。
      保留 StackTraceSupport —— 7z.dll 初始化失败等诊断依赖异常堆栈。
      UseSystemResourceKeys 会把异常消息换成资源 ID，但本程序自己的提示
      全部来自 resx，不受影响。
    -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>

    <!-- AOT 下不需要（也无法）运行时反射生成，显式关掉以缩小体积 -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!--
    UPX 压缩由 csproj 的 UpxCompressNativeBinary target 完成，**原地**压缩
    $(PublishDir) 里的原生 exe，不需要任何额外输出目录或外部脚本：

      dotnet publish -c Release -p:PublishProfile=Properties\PublishProfiles\win-x64-aot.pubxml

    **默认就带 UPX**：只要 tools\upx\upx.exe（或仓库根 upx.exe）存在就会自动压缩到约 3.5 MB，
    不需要每次传参数。要临时关掉用 -p:EnableUpx=false，要换一个 upx 用 -p:UpxPath=...。

    产物落在默认发布目录
    ArchivePasswordTestTool\bin\Release\net10.0\win-x64\publish\ArchivePasswordTestTool.exe，
    与 win-x64.pubxml 的位置完全一致（CI 也是从这里取产物上传）。
  -->

</Project>

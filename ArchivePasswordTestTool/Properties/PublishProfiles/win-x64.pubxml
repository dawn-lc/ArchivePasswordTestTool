<Project>

  <!--
    单文件发布配置：dotnet publish -c Release -p:PublishProfile=Properties\PublishProfiles\win-x64.pubxml
    产物：bin\Release\net10.0\win-x64\publish\ArchivePasswordTestTool.exe（自包含运行时，免安装 .NET）
    说明：7z.dll 按设计保持外部依赖（自动查找已安装 7-Zip，或用 -lib 指定），不打包进单文件
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- IL 裁剪：partial 模式仅裁剪标记可裁的框架程序集，第三方库（Spectre.Console）整份保留 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!--
      裁剪默认禁用内置 COM 互操作（ComImport/RCW），必须显式启用，否则运行时抛
      "Built-in COM has been disabled via a feature switch"；属性名见官方
      trimming-options 文档 Framework features disabled when trimming 表
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!--
      抑制 IL2026（Trim analysis warning，框架内部噪音，非本工程代码）：
      该警告来自被特性开关整类保留的 Internal.Runtime.InteropServices.ComActivator
      类工厂路径，其内部方法标注 RequiresUnreferencedCode（内置 COM 裁剪不安全）。
      本工程确实依赖内置 COM（7z.dll 的 RCW 封装），支持代码已由上述开关显式保留，
      运行时可用，故该警告是预期噪音，窄范围抑制。详见 https://aka.ms/dotnet-illink/com
    -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>

    <!--
      刻意不设置 InvariantGlobalization：不变全球化模式下 CurrentUICulture 被固定为
      InvariantCulture，ResourceManager 只探测中性资源（英文），本项目的 zh-CN 卫星
      资源会被完全无视（实测：卫星 dll 就在 exe 旁也回退英文）。
      本工具是多语言本地化程序，自动语言匹配优先于约 1.8MB 体积。
    -->

    <!-- 只打包 zh 系 + ja/fr/ru 卫星资源（默认会把运行时自带的十余种语言全部塞进单文件） -->
    <SatelliteResourceLanguages>zh-Hans;zh-CN;ja;fr;ru</SatelliteResourceLanguages>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      附加 feature switches：关闭调试/热重载/EventSource 等运行时特性，进一步减小体积。
      注意保留 StackTraceSupport（默认 true）：7z.dll 初始化失败诊断依赖异常堆栈
    -->
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!--
      为什么不用 UPX（2026-10 实测结论）：
      UPX 改写 PE 后 .NET 单文件 host 无法从磁盘自身文件按烧录偏移读取 bundle（提取
      运行时组件依赖原始布局），lzma 最优模式与 overlay=copy 两种模式均触发
      "Failure processing application bundle; Arithmetic overflow while reading bundle"。
      host 读取自身文件是 PublishSingleFile 的机制核心，与任何改写文件布局的压缩器
      （UPX/Themida 等）机制性不兼容，无配置可解。bundle 内置 deflate 压缩
      （EnableCompressionInSingleFile）已是官方受支持的等效手段。
    -->
  </PropertyGroup>

</Project>

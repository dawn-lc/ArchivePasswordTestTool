<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ArchivePasswordTestTool.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      兼容旧版 Windows 10：不给自己生成的 apphost / singlefilehost 打 CETCOMPAT 标记。.NET 9 起 SDK 默认用 /CETCOMPAT 链接宿主，命令行 app 在启用了影子栈的机器上会开启 CET；而 .NET 10 的 CoreCLR 启动时若检测到影子栈已启用、系统却不支持带 CONTEXT 的特殊用户态 APC（QueueUserAPC2 + SPECIAL_USER_APC|CALLBACK_DATA_CONTEXT），会直接 fail-fast："Your Windows doesn't fully support CET. Please install all available Windows updates."（COR_E_EXECUTIONENGINE / 0x80131506，发生在托管 Main 之前）。低版本 Win10 21H2/22H2 未打到 1904x.5007+ 的累积更新、旧 Win11 以及 ARM64 WOW64 (<24H2) 都会命中。去掉该标记后进程不会启用影子栈，检查自然跳过；代价是失去 CET 加固。官方退出方式见 https://learn.microsoft.com/dotnet/core/compatibility/interop/9.0/cet-support
    -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <!--
    版本号唯一真相源是 git tag，源码里不再存在版本常量。发布时由 CI 传入 -p:AppVersion=2.1.0 -p:AppVersionType=Release（见 .github/workflows/release.yml），本地开发构建保持 0.0.0-Dev。这样「改了源码忘打 tag」或「打完 tag 忘改源码」这两类不一致从根上消失——以前 release.yml 需要用正则从 Program.cs 抽版本号来比对，现在没必要了。

    注意 AppVersion 必须是三段 x.y.z：Upgrade.IsNewerVersion 在段数不一致时直接判定为「无更新」（静默失效），所以 release 工作流对 tag 格式做了硬校验。
  -->
  <PropertyGroup>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <AppVersionType Condition="'$(AppVersionType)' == ''">Dev</AppVersionType>

    <!-- 同步给 SDK，让 exe 的文件版本属性（资源管理器里看到的）与界面显示一致 -->
    <Version>$(AppVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      编译进程序集元数据供 Program.cs 读取，而非依赖 AssemblyVersion：AssemblyVersion 会被补成四段（2.1.0 → 2.1.0.0），读出来还要再截断，容易产生歧义
    -->
    <AssemblyMetadata Include="AppVersion" Value="$(AppVersion)" />
    <AssemblyMetadata Include="AppVersionType" Value="$(AppVersionType)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      标题 ASCII 艺术字已内嵌为常量（Ui/Banner.cs），不再需要 Figgle / Figgle.Fonts（后者把全部字体数据打进程序，单文件发布里约占 0.5MB）
    -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      仅为 VS 解决方案资源管理器把 Resources.Designer.cs 折叠到 Resources.resx 下（纯 IDE 展示）。dotnet build 不使用这些元数据。
    -->
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!--
    此处刻意不再给 EmbeddedResource 挂 Generator / LastGenOutput。那是「保存 resx 时自动重新生成 Designer.cs」的指令，而本项目的 Resources.Designer.cs 已改为手工维护（中文 XML 注释、人工排序）。留着它意味着任何人用 VS 设计器打开 Resources.resx 并保存，都会覆盖整个文件、抹掉手写注释。resx 的嵌入本身来自 SDK 默认 glob（**/*.resx），与这些元数据无关。
  -->

  <!--
    各语言资源直接编进主程序集，不生成卫星程序集。原因：Native AOT 无法把卫星程序集打进 exe，产物必然是「exe + 语言目录」，与「单 exe 下载 + 自更新替换单文件」的发布形态冲突。

    做法：文件名去掉 .Culture 段（ResourcesZhCn.resx），再用 LogicalName 指定「{BaseName}.{culture}.resources」——SDK 不会再按 culture 生成卫星程序集，而 EmbeddedResourceManager 能按 culture 链在主程序集里找到它们。

    注意：默认的 ResourceManager 只在卫星程序集里找 culture 资源，把资源编进主程序集后它只会返回中性（英文）文案，所以 Resources.Designer.cs 已改用 EmbeddedResourceManager。
  -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx" LogicalName="ArchivePasswordTestTool.Properties.Resources.resources" />
    <EmbeddedResource Update="Properties\ResourcesZhCn.resx" LogicalName="ArchivePasswordTestTool.Properties.Resources.zh-CN.resources" />
    <EmbeddedResource Update="Properties\ResourcesJa.resx" LogicalName="ArchivePasswordTestTool.Properties.Resources.ja.resources" />
    <EmbeddedResource Update="Properties\ResourcesFr.resx" LogicalName="ArchivePasswordTestTool.Properties.Resources.fr.resources" />
    <EmbeddedResource Update="Properties\ResourcesRu.resx" LogicalName="ArchivePasswordTestTool.Properties.Resources.ru.resources" />
  </ItemGroup>

  <!--
    UPX 压缩 AOT 原生产物：9.0 MB → 3.4 MB（约 38%），启动时间不变（实测 130ms → 121ms）。纯 MSBuild 实现，发布流程里不引入任何外部脚本。

    **默认自动获取最新版**，不需要每次手传参数：
      1. upx.exe 已在 tools\upx\ 或仓库根        → 直接使用（不联网）
      2. 否则自动从 GitHub Releases 下载最新 win64 版本并解压到 tools\upx\
      3. 下载失败（离线/被墙）→ 警告后跳过压缩，构建不中断

    可选参数：
      -p:UpxVersion=5.2.1      固定版本（产物可重现，CI 推荐）
      -p:UpxForceUpdate=true   忽略缓存，重新探测最新版
      -p:EnableUpx=false       完全关闭压缩
      -p:UpxPath=C:\x\upx.exe  使用自备的 upx
      -p:UpxAutoDownload=false 禁止自动下载，找不到就跳过

    为什么是 AfterTargets="CopyNativeBinary" 而不是 "Publish"：ILCompiler 的原生二进制由 CopyNativeBinary 复制进 $(PublishDir)，该 target 本身也是 AfterTargets="Publish"。两个同样挂在 Publish 之后的 target 执行顺序不确定 —— 实测 UPX 先跑了，压缩的是中间产物，随后被 CopyNativeBinary 覆盖回未压缩文件（日志显示 "Packed 1 file" 但输出目录里仍是 9.4 MB，就是这个原因）。挂在 CopyNativeBinary 之后，顺序才是确定的。
  -->
  <PropertyGroup>
    <EnableUpx Condition="'$(EnableUpx)' == ''">true</EnableUpx>
    <UpxAutoDownload Condition="'$(UpxAutoDownload)' == ''">true</UpxAutoDownload>
    <UpxForceUpdate Condition="'$(UpxForceUpdate)' == ''">false</UpxForceUpdate>

    <_UpxToolDir>$(MSBuildThisFileDirectory)..\tools\upx\</_UpxToolDir>
  </PropertyGroup>

  <!--
    解析 upx.exe：显式路径 → 约定位置 → 自动下载。不查 GitHub API（未认证配额 60 次/小时很容易被耗尽），而是跟随 releases/latest 的 302 重定向拿 tag —— 不消耗任何 API 配额。
  -->
  <UsingTask TaskName="EnsureUpxToolTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExplicitPath ParameterType="System.String" />
      <ToolDirectory ParameterType="System.String" Required="true" />
      <RequestedVersion ParameterType="System.String" />
      <AutoDownload ParameterType="System.Boolean" Required="true" />
      <ForceUpdate ParameterType="System.Boolean" Required="true" />
      <ResultPath ParameterType="System.String" Output="true" />
      <ResolvedVersion ParameterType="System.String" Output="true" />
      <WasDownloaded ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)..\build\BuildTasks.cs" />
    </Task>
  </UsingTask>

  <Target Name="EnsureUpxTool" Condition="'$(PublishAot)' == 'true' and '$(EnableUpx)' == 'true'">
    <EnsureUpxToolTask ExplicitPath="$(UpxPath)" ToolDirectory="$(_UpxToolDir)" RequestedVersion="$(UpxVersion)" AutoDownload="$(UpxAutoDownload)" ForceUpdate="$(UpxForceUpdate)">
      <Output TaskParameter="ResultPath" PropertyName="_UpxToolPath" />
      <Output TaskParameter="ResolvedVersion" PropertyName="_UpxResolvedVersion" />
      <Output TaskParameter="WasDownloaded" PropertyName="_UpxWasDownloaded" />
    </EnsureUpxToolTask>
  </Target>

  <Target Name="UpxCompressNativeBinary" AfterTargets="CopyNativeBinary" DependsOnTargets="EnsureUpxTool" Condition="'$(PublishAot)' == 'true' and '$(EnableUpx)' == 'true' and '&quot;$(_UpxToolPath)&quot;' != ''">
    <PropertyGroup>
      <_UpxBinary>$(PublishDir)$(TargetName)$(NativeBinaryExt)</_UpxBinary>
    </PropertyGroup>

    <Error Condition="!Exists('$(_UpxBinary)')" Text="UPX 目标不存在：$(_UpxBinary)（CopyNativeBinary 未产出原生二进制？）" />

    <!-- UPX 自己会打印压缩前后的体积与比例，不必在这里重复计算 -->
    <Message Importance="high" Text="UPX 压缩（$(_UpxResolvedVersion)）：$(_UpxBinary)" />
    <Exec Command="&quot;$(_UpxToolPath)&quot; --best &quot;$(_UpxBinary)&quot;" />
  </Target>

  <!-- 仅 AOT 发布且本次未压缩时提示，避免单文件发布被噪音刷屏 -->
  <Target Name="UpxSkipNotice" AfterTargets="CopyNativeBinary" DependsOnTargets="EnsureUpxTool" Condition="'$(PublishAot)' == 'true' and ('$(EnableUpx)' != 'true' or '&quot;$(_UpxToolPath)&quot;' == '')">
    <Message Importance="high" Condition="'$(EnableUpx)' != 'true'" Text="UPX 压缩已按 -p:EnableUpx=false 关闭。" />
    <Message Importance="high" Condition="'$(EnableUpx)' == 'true'" Text="UPX 不可用，AOT 产物保持未压缩（约 9 MB）。可手工放入 tools\upx\upx.exe，或检查网络。" />
  </Target>

  <!--
    ============================================================================
    内嵌 7z.dll：构建期自动获取最新版，运行期解压到用户缓存目录再加载
    ============================================================================

    动机：原先 7z.dll 是硬性外部依赖——没装 7-Zip 的用户双击即报错退出。内嵌后「下载单个 exe 即可用」，且多进程工作进程也能拿到同一份 dll。

    获取方式（全部官方件，不信任任何第三方镜像）：
      ① 下载 ip7z/7zip 的 7zr.exe（602KB 官方独立解包器）
      ② 下载 7zNNNN-x64.exe（官方安装包，本质是 7z SFX）
      ③ 用 7zr 解包，取出 7z.dll + License.txt
    三条命令都来自 github.com/ip7z/7zip（7-zip.org 官方指定的 GitHub 发布点）。

    许可（必须遵守，7-Zip 是 LGPL 不是公有领域）：
      7z.dll 采用 GNU LGPL 2.1+（含 unRAR 限制）+ BSD。官方 license.txt 明确要求「以二进制形式再分发时必须附带许可证信息」，因此 License.txt 与 dll 一起内嵌，并在运行期写到解压目录旁。

    可选参数：
      -p:SevenZipVersion=26.05        固定版本（产物可重现，CI 推荐）
      -p:EnableEmbeddedSevenZip=false  关闭内嵌（回到「必须自行安装 7-Zip」）
      -p:SevenZipAutoDownload=false     禁止下载；若 tools\7zip\7z.dll 已存在仍会内嵌
      -p:SevenZipForceUpdate=true       忽略缓存，重新探测最新版
  -->
  <PropertyGroup>
    <EnableEmbeddedSevenZip Condition="'$(EnableEmbeddedSevenZip)' == ''">true</EnableEmbeddedSevenZip>
    <SevenZipAutoDownload Condition="'$(SevenZipAutoDownload)' == ''">true</SevenZipAutoDownload>
    <SevenZipForceUpdate Condition="'$(SevenZipForceUpdate)' == ''">false</SevenZipForceUpdate>
    <_SevenZipToolDir>$(MSBuildThisFileDirectory)..\tools\7zip\</_SevenZipToolDir>

    <!--
      拿不到可内嵌的 7z.dll 时是否直接失败。本地默认 false（缺网也能构建，产物退回「需自行安装 7-Zip」），CI 与发布必须传 true。
      为什么 CI 必须严格：BuildTasks 里的下载失败原本只记 warning，而 CI 的 smoke test 因为 runner 上装了 7-Zip
      会走「已安装」分支照样通过 —— 于是不自包含的产物会静默上传，恰好是本功能要消除的那个问题。
    -->
    <RequireEmbeddedSevenZip Condition="'$(RequireEmbeddedSevenZip)' == ''">false</RequireEmbeddedSevenZip>
  </PropertyGroup>

  <UsingTask TaskName="EnsureSevenZipDllTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ToolDirectory ParameterType="System.String" Required="true" />
      <RequestedVersion ParameterType="System.String" />
      <AutoDownload ParameterType="System.Boolean" Required="true" />
      <ForceUpdate ParameterType="System.Boolean" Required="true" />
      <RequireEmbeddedSevenZip ParameterType="System.Boolean" Required="true" />
      <DllPath ParameterType="System.String" Output="true" />
      <LicensePath ParameterType="System.String" Output="true" />
      <ResolvedVersion ParameterType="System.String" Output="true" />
      <WasDownloaded ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)..\build\BuildTasks.cs" />
    </Task>
  </UsingTask>

  <!--
    在资源生成之前把 7z.dll 与许可证加入内嵌资源列表。必须用 target 动态添加：项目求值阶段文件可能还不存在（首次构建要现下载），字面 Include 一个不存在的文件会让构建直接报错。

    **设计时构建必须跳过**（DesignTimeBuild=true / BuildingProject=false）：IDE 为 IntelliSense 会频繁跑设计时构建，若不跳过就会：
      ① 每次编辑都去联网（慢，且本机/代理环境下 TLS 常失败）；
      ② 失败信息报进“错误列表”（用户看到的就是那条 7z.dll 下载失败）。
    设计时编译根本用不到这个资源（只按名查找，代码里没有强类型引用），所以跳过不会影响补全与跳转。
  -->
  <Target Name="EnsureSevenZipDllAsset" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' != 'false'">
    <Error Condition="'$(RequireEmbeddedSevenZip)' == 'true' and '$(EnableEmbeddedSevenZip)' != 'true'" Text="RequireEmbeddedSevenZip=true 与 EnableEmbeddedSevenZip=false 相互矛盾：要么允许内嵌，要么放弃「自包含」要求。" />

    <EnsureSevenZipDllTask ToolDirectory="$(_SevenZipToolDir)" RequestedVersion="$(SevenZipVersion)" AutoDownload="$(SevenZipAutoDownload)" ForceUpdate="$(SevenZipForceUpdate)" RequireEmbeddedSevenZip="$(RequireEmbeddedSevenZip)">
      <Output TaskParameter="DllPath" PropertyName="_SevenZipDllPath" />
      <Output TaskParameter="LicensePath" PropertyName="_SevenZipLicensePath" />
      <Output TaskParameter="ResolvedVersion" PropertyName="_SevenZipResolvedVersion" />
      <Output TaskParameter="WasDownloaded" PropertyName="_SevenZipWasDownloaded" />
    </EnsureSevenZipDllTask>

    <ItemGroup Condition="'$(EnableEmbeddedSevenZip)' == 'true' and Exists('$(_SevenZipDllPath)')">
      <EmbeddedResource Include="$(_SevenZipDllPath)" LogicalName="ArchivePasswordTestTool.Native.7z.dll" />
    </ItemGroup>

    <ItemGroup Condition="'$(EnableEmbeddedSevenZip)' == 'true' and Exists('$(_SevenZipLicensePath)')">
      <EmbeddedResource Include="$(_SevenZipLicensePath)" LogicalName="ArchivePasswordTestTool.Native.7z-License.txt" />
    </ItemGroup>
  </Target>

</Project>

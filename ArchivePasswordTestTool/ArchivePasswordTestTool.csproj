<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ArchivePasswordTestTool.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      兼容旧版 Windows 10：不给自己生成的 apphost / singlefilehost 打 CETCOMPAT 标记。
      .NET 9 起 SDK 默认用 /CETCOMPAT 链接宿主，命令行 app 在启用了影子栈的机器上会开启 CET；
      而 .NET 10 的 CoreCLR 启动时若检测到影子栈已启用、系统却不支持带 CONTEXT 的特殊用户态
      APC（QueueUserAPC2 + SPECIAL_USER_APC|CALLBACK_DATA_CONTEXT），会直接 fail-fast：
      "Your Windows doesn't fully support CET. Please install all available Windows updates."
      （COR_E_EXECUTIONENGINE / 0x80131506，发生在托管 Main 之前）。
      低版本 Win10 21H2/22H2 未打到 1904x.5007+ 的累积更新、旧 Win11 以及 ARM64 WOW64 (<24H2) 都会命中。
      去掉该标记后进程不会启用影子栈，检查自然跳过；代价是失去 CET 加固。
      官方退出方式见 https://learn.microsoft.com/dotnet/core/compatibility/interop/9.0/cet-support
    -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <!--
    版本号唯一真相源是 git tag，源码里不再存在版本常量。
    发布时由 CI 传入 -p:AppVersion=2.1.0 -p:AppVersionType=Release（见 .github/workflows/release.yml），
    本地开发构建保持 0.0.0-Dev。这样「改了源码忘打 tag」或「打完 tag 忘改源码」这两类
    不一致从根上消失——以前 release.yml 需要用正则从 Program.cs 抽版本号来比对，现在没必要了。

    注意 AppVersion 必须是三段 x.y.z：Upgrade.IsNewerVersion 在段数不一致时直接判定为
    「无更新」（静默失效），所以 release 工作流对 tag 格式做了硬校验。
  -->
  <PropertyGroup>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <AppVersionType Condition="'$(AppVersionType)' == ''">Dev</AppVersionType>

    <!-- 同步给 SDK，让 exe 的文件版本属性（资源管理器里看到的）与界面显示一致 -->
    <Version>$(AppVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      编译进程序集元数据供 Program.cs 读取，而非依赖 AssemblyVersion：
      AssemblyVersion 会被补成四段（2.1.0 → 2.1.0.0），读出来还要再截断，容易产生歧义
    -->
    <AssemblyMetadata Include="AppVersion" Value="$(AppVersion)" />
    <AssemblyMetadata Include="AppVersionType" Value="$(AppVersionType)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      标题 ASCII 艺术字已内嵌为常量（Ui/Banner.cs），不再需要 Figgle / Figgle.Fonts
      （后者把全部字体数据打进程序，单文件发布里约占 0.5MB）
    -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.zh-CN.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
	
</Project>

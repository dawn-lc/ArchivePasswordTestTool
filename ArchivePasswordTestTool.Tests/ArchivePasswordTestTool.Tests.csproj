<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      测试项目不参与发布。不写这行的话，在仓库根执行
      `dotnet publish -c Release -p:PublishProfile=Properties\PublishProfiles\win-x64-aot.pubxml`
      会把整个解决方案都发布一遍：主项目的 PublishProfile 解析不到（那个文件只存在于主项目）
      于测试项目，于是多出一条 NETSDK1198 警告，还会凭空产出 net10.0\publish\ 目录。
      Publish 目标的执行条件是 $(IsPublishable) == 'true'，设 false 即整个绕过。
    -->
    <IsPublishable>false</IsPublishable>
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchivePasswordTestTool\ArchivePasswordTestTool.csproj" />
  </ItemGroup>

</Project>
